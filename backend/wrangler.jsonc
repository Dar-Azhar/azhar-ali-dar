{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The contact form's backend. The site reaches it through its service binding only: no public
  // address, no previews.
  "name": "azhar-ali-dar-2-www-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  // Enquiries. 
  "d1_databases": [{"binding":"DB","database_name":"azhar-ali-dar-2-www-enquiries","database_id":"395982fd-281c-4672-aef9-e5770b1c2b15","migrations_dir":"migrations"}],
  "vars": {
    "SITE_NAME": "Azhar Ali Dar",
    "SITE_ID": "azhar-ali-dar-2",
    // Where enquiries are emailed: keep it the same as forms.inbox in sites/main/site.config.ts.
    "FORM_INBOX": "dev.darazhar@gmail.com",
    "GATEWAY_URL": "https://gateway.craeft.org"
  }
  // Secrets (wrangler secret put): TURNSTILE_SECRET_KEY, FORMS_KEY.
}
